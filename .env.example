# =============================================================================
# acidwurx-nexus environment manifest — copy to `.env`, chmod 600, fill ONCE.
# bootstrap.sh and all probes hydrate from here at t=0. ZERO mid-run prompts.
# Legacy migration note: values formerly lived in Bitwarden
#   (bw get password acidwurx/warp-private-key -> WARP_PRIVATE_KEY,
#    bw get password acidwurx/warp-address     -> WARP_ADDRESS)
# and are being superseded by sops+age encrypted blobs (NEXO_VAULT_KEY).
# =============================================================================

# --- Cloudflare (REQUIRED for edge stages; probes degrade gracefully) --------
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_TOKEN=
ADMIN_EMAIL=

# --- GitHub (REQUIRED only for remote provisioning/push) ---------------------
GITHUB_TOKEN=
GITHUB_OWNER=

# --- Secrets governance -------------------------------------------------------
# age secret key (AGE-SECRET-KEY-1...) OR legacy 32-byte hex symmetric key.
# If unset, the engine generates a fresh age keypair into
# ~/.config/nexo/age/keys.txt (chmod 600, outside the repo).
NEXO_VAULT_KEY=

# --- z.ai handoff plane (D1 telemetry ingest) ----------------------------------
# Orchestrator pushes normalized wave results through the tunnel to the edge
# ingest worker; HMAC key signs every envelope (see docs/interop/ZAI_HANDOFF_SCHEMA.md).
NEXO_INGEST_URL=https://ingest.acidwurx.org/v1/telemetry
NEXO_INGEST_HMAC_KEY=
D1_DATABASE_ID=

# --- Secure telemetry area (GitHub push target for wave artifacts) --------------
# Public repo of age-ENCRYPTED payloads + plaintext redacted briefings, so the
# AI peer can read runs by URL without ever holding credentials.
NEXO_TELEMETRY_REPO=https://github.com/ajdhoward/acidwurx-nexus-telemetry.git
NEXO_TELEMETRY_DIR=
NEXO_AGE_RECIPIENT=
NEXO_TELEMETRY_PASSPHRASE=

# --- Bulk discovery knobs (probes 06-12) ------------------------------------------
# NOTE: multi-word values MUST stay quoted — .env is sourced as shell.
FLEET_NODES="markslone:192.168.1.179:adam jessicafletcher:192.168.1.138:adam barryslone:192.168.1.186:adam tanyacheex:192.168.1.164:adam"
OPENWRT_NODES="sharon:192.168.1.1 openwrt-secondary:192.168.1.250"
OPENWRT_SSH_USER=root
NEXO_GH_AUDIT_REPOS="acidwurx-nexus,acidwurx-nexus-telemetry"
CANARY_HOST=jessicafletcher
PROBE_TIMEOUT=600

# --- Rotation completion markers (flip to 1 as each leaked credential is rotated) ---
ROTATION_CF_TOKEN=0
ROTATION_LITELLM_KEY=0
ROTATION_SEARXNG_KEY=0
ROTATION_BITWARDEN=0
ROTATION_WARP_KEYS=0

# --- Notifications & automatic progression ---------------------------------------
# ntfy.sh topic (phone: ntfy app subscribe; PC: https://ntfy.sh/<topic>).
NEXO_NTFY_TOPIC=
# systemd user-timer schedule for the auto wave (install_cron.sh):
NEXO_WAVE_SCHEDULE="*-*-* 04:30:00"
# 1 = scheduled wave also executes AUTO-SAFE remediations (APPLY=1)
NEXO_AUTOREMEDIATE=0
# repo used by tools/access/request_access.py
NEXO_ACCESS_REPO=ajdhoward/acidwurx-nexus

# --- WARP breakout (markslone Path-B) -----------------------------------------
WARP_PRIVATE_KEY=
WARP_ADDRESS=172.16.0.2/32
CF_WARP_ENROLLMENT_TOKEN=

# --- Inference / cockpit plane -------------------------------------------------
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
SEARXNG_SECRET_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# --- Fleet facts (extracted from operational archive; probes re-verify) -------
LAN_SUBNET=192.168.1.0/24
MARKSLONE_LAN_IP=192.168.1.179
JESSICAFLETCHER_LAN_IP=192.168.1.138
BARRYSLONE_LAN_IP=192.168.1.186
TANYACHEEX_LAN_IP=192.168.1.164
OPENWRT_PRIMARY_IP=192.168.1.1
ISP_CGNAT_IP=88.97.176.163
MESH_SUBNET=100.64.0.0/10
SUBNET_ROUTER_IP=192.168.1.179
TARGET_APPLIANCE_MAC=
APPLIANCE_DOMAIN=acidwurx.org
API_HOSTNAME=api.acidwurx.org
COCKPIT_HOSTNAME=cockpit.acidwurx.org
AI_GATEWAY_ID=acidwurx
DAILY_SPEND_CAP_PENCE=500
MODEL_GGUF=qwen2.5-coder-7b-instruct-q4_k_m.gguf
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-7B-Instruct-GGUF/resolve/main/qwen2.5-coder-7b-instruct-q4_k_m.gguf

# --- Engine behavior (all optional; defaults are zero-prompt safe) -------------
NEXO_WORKSPACE=
NEXO_RECEIPT=
NEXO_ALLOW_HIGH_RISK=0
NEXO_ALLOW_LOCAL_SHELL=0
