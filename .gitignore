# Catalog renders + deployment receipts (regenerated by launch.py)
platform/rendered/

# Fleet backups — CONTAIN SECRETS (wgcf keys, cloudflared env). Never commit.
backups/

# Runtime
__pycache__/
*.pyc
*.log
node_modules/
dist/
.wrangler/

# OS noise
.DS_Store
Thumbs.db
